{
    "name": "passmgr",
    "main": "src/app.js",
    "compatibility_date": "2026-06-03",
    "compatibility_flags": ["nodejs_compat"],
    "assets": {
        "directory": "./web/dist/",
        "binding": "assets"
    },
    "build": {
        "command": "npm install && cd web && npm install && npm run build"
    },
    "kv_namespaces": [
        {
            "binding": "data",
            "id": "8251b52301224431b78f1250d058ad6c"
        }
    ]
}
